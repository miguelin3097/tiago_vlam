<launch>

    <!-- 1) Lanzar la simulación TIAGo en Gazebo -->
    <!--<include file="$(find tiago_gazebo)/launch/tiago_gazebo.launch">
        <arg name="world" value="objects_on_table" />
    </include>-->

    <!-- 2) Lanzar tus nodos -->
    <node pkg="vlm" type="hello_world.py" name="gui" output="screen"/>
    <node pkg="vlm" type="gemini_vision_server.py" name="gemini" output="screen"/>
    <node pkg="vlm" type="plan_action_server.py" name="plan" output="screen"/> 
    <node pkg="vlm" type="pickup_server.py" name="pick" output="screen"/>
    <node pkg="vlm" type="metrics_server.py" name="metrics" output="screen"/>
    <node pkg="vlm" type="transform_server.py" name="transform" output="screen"/> 
    <node pkg="vlm" type="tiago_web_display.py" name="web_server" output="screen"/>
    <node pkg="vlm" type="remote_firefox_launcher.sh" name="trigger_robot_browser" output="screen" />
    
    

</launch>
